# 默认使用 JSON，不填写也可以继续运行原网站。
STORAGE_DRIVER=json
HOST=0.0.0.0
PORT=3000

# 切换到 MySQL 时改为 mysql，并填写本机数据库账号。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=discrete_math_review
DB_CONNECTION_LIMIT=10
BACKUP_DIR=backups
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_HOUR=3
BACKUP_RETENTION_DAYS=30
AUTO_DATABASE_MAINTENANCE_ENABLED=true
DATABASE_MAINTENANCE_HOUR=4
QUIZ_SESSION_RETENTION_DAYS=7
# 0 表示永久保留用户的日常答题记录。
ANSWER_RECORD_RETENTION_DAYS=0
LOG_RETENTION_DAYS=14
AUTH_RATE_LIMIT_MAX=30
WRITE_RATE_LIMIT_MAX=180

# 正式部署时请换成随机长字符串。
SESSION_SECRET=change-this-session-secret
